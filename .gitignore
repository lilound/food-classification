# Environnement virtuel
.venv/

# Cache Python
__pycache__/
*.pyc
*.pyo

# Dataset (conserver uniquement .gitkeep)
/data/*
!/data/.gitkeep

# Modèles entraînés
*.pth
*.pt

# Résultats
/results/*
!/results/.gitkeep

# Archives et figures locales du dossier benchmark
/benchmark/index.md
/benchmark/experiences/
/benchmark/courbes_par_modele/
/benchmark/comparaison/
/benchmark/protocole/
/benchmark/nuit/
/benchmark/nuit.zip
